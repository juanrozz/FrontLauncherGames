@model GameLauncher.Models.CommentViewModel

<div class="comment-item" data-comment-id="@Model.Id">
    <div class="comment-content-preview" onclick="openDetailModal(@Model.Id)">
        <p class="comment-text">@(Model.Content.Length > 80 ? Model.Content.Substring(0, 80) + "..." : Model.Content)</p>
    </div>

    <div class="comment-stats">
        <button class="comment-stat-btn" onclick="event.stopPropagation(); openDetailModal(@Model.Id)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
            <span class="replies-count-@Model.Id">@Model.RepliesCount</span>
        </button>

        <button class="comment-stat-btn like-btn @(Model.IsLikedByCurrentUser ? "liked" : "")"
                onclick="event.stopPropagation(); toggleLike(@Model.Id)"
                data-comment-id="@Model.Id">
            <svg width="16" height="16" viewBox="0 0 24 24"
                 fill="@(Model.IsLikedByCurrentUser ? "#FFA4A4" : "none")"
                 stroke="@(Model.IsLikedByCurrentUser ? "#FFA4A4" : "currentColor")" stroke-width="1.5">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
            <span class="likes-count-@Model.Id">@Model.LikesCount</span>
        </button>
    </div>

    <div class="comment-author">
        <div class="comment-avatar-placeholder">
            @if (!string.IsNullOrEmpty(Model.UserAdp))
            {
                <img src="/Store/UserPhoto?adp=@Model.UserAdp"
                     alt="@Model.UserName"
                     class="comment-avatar-img"
                     onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="1.5" style="display:none;">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
            }
            else
            {
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="1.5">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
            }
        </div>
        <div class="comment-author-info">
            <span class="comment-title-label">@(Model.Title ?? "Comment")</span>
            <span class="comment-meta">@FormatTimeAgo(Model.CreatedAt) by <strong>@Model.UserName</strong></span>
        </div>
    </div>
</div>

@functions {
    string FormatTimeAgo(DateTime date)
    {
        var diff = DateTime.Now - date;
        if (diff.TotalMinutes < 1) return "just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes} min. ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours} hrs. ago";
        if (diff.TotalDays < 30) return $"{(int)diff.TotalDays} days ago";
        if (diff.TotalDays < 365) return $"{(int)(diff.TotalDays / 30)} months ago";
        return $"{(int)(diff.TotalDays / 365)} years ago";
    }
}