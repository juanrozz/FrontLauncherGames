@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>@ViewData["Title"] - Game Launcher</title>
	<link rel="stylesheet" href="~/css/site.css" />
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>
<body class="body-index">

	@{
		var userName = Context.Session.GetString("UserName");
		var token = Context.Session.GetString("Token");
		var isLoggedIn = !string.IsNullOrEmpty(userName) && !string.IsNullOrEmpty(token);
		var userPhoto = Context.Session.GetString("UserPhoto");
	}

	@{
		var isDistribute = Context.Request.Path.ToString().ToLower() is var path
						   && (path.Contains("forums")
						   || path.Contains("documentation")
						   || path.Contains("playercomments"));
	}

	<!-- NAVBAR -->
	<nav class="navbar">
		<div class="nav-left">
			<div class="nav-logo">
				<img class="logo-icon" src="~/images/Isotipo Png.png" />
				@if (isDistribute)
				{
					<a asp-controller="Store" asp-action="Index" class="logo-text">@Localizer["nav_store"]</a>
				}
				else
				{
					<span class="logo-text">@Localizer["nav_store"]</span>
				}
			</div>

			<ul class="nav-links">
				<li class="dropdown-container">
					<a class="dropdown-trigger @(isDistribute ? "active" : "")">
						@Localizer["nav_distribute"] <i class="fa-solid fa-chevron-down chevron"></i>
					</a>
					<ul class="dropdown-menu">
						<li><a asp-controller="Store" asp-action="Forums">@Localizer["nav_forums"]</a></li>
						<li><a asp-controller="Store" asp-action="Documentation">@Localizer["nav_docs"]</a></li>
						<li><a asp-controller="Store" asp-action="PlayerComments">@Localizer["nav_comments"]</a></li>
					</ul>
				</li>
			</ul>
		</div>

		<div class="nav-right">
			<div class="nav-search">
				<i class="fa-solid fa-magnifying-glass search-icon"></i>
				<input type="text" id="navSearchInput" class="search-input" placeholder="@Localizer["nav_search"]" autocomplete="off" />
			</div>

			<div class="dropdown-container lang-dropdown">
				<a class="lang-btn">
					<i class="fa-solid fa-globe world-icon"></i>
				</a>
				<ul class="dropdown-menu lang-menu">
					<li><a href="@Url.Action("SetLanguage", "Culture", new { culture = "es" })"> Spanish</a></li>
					<li><a href="@Url.Action("SetLanguage", "Culture", new { culture = "en" })"> English</a></li>
				</ul>
			</div>

			@if (isLoggedIn)
			{
				<div class="dropdown-container user-dropdown">
					<a class="user-btn">
						@if (!string.IsNullOrEmpty(userPhoto))
						{
							<img src="@userPhoto" alt="@userName" class="user-avatar" />
						}
						else
						{
							<i class="fa-solid fa-user user-icon"></i>
						}
						<span class="user-name">@userName</span>
						<i class="fa-solid fa-chevron-down chevron"></i>
					</a>
					<ul class="dropdown-menu user-menu">
						<li><a asp-controller="Account" asp-action="Logout">@Localizer["nav_logout"]</a></li>
					</ul>
				</div>
			}
			else
			{
				<a asp-controller="Account" asp-action="Login" class="btn-signin">@Localizer["nav_login"]</a>
			}
		</div>
	</nav>

	<!-- CONTENIDO -->
	<main class="@(isDistribute ? "" : "store-content")">
		@RenderBody()
	</main>

	<!-- FOOTER -->
	<footer class="main-footer">
		<div class="footer-logo-container">
			<img src="~/images/FooterFoundever.png" alt="" class="footer-logo" />
			<div class="footer-line"></div>
			<img src="~/images/R&D.jpg" alt="Software R&D" class="footer-logo rd-logo" />
		</div>
	</footer>
	<script src="~/js/game-showcase.js"></script>
	<script src="~/js/nav-search.js"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>